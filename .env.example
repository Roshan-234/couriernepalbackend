# Copy to `.env` and fill in real values. NEVER commit the real .env.
# On cPanel you can instead set these in the Python App's environment-variables UI.

FLASK_ENV=production

# ── MySQL (create the DB + user in cPanel → MySQL Databases) ────────────
MYSQL_HOST=localhost
MYSQL_USER=cpaneluser_moonlight
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=cpaneluser_moonlight

# ── App secrets (generate with: python -c "import secrets;print(secrets.token_hex(32))") ──
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# ── Mail (SMTP) ─────────────────────────────────────────────────────────
MAIL_SERVER=mail.yourdomain.com
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_USERNAME=no-reply@yourdomain.com
MAIL_PASSWORD=change-me
MAIL_DEFAULT_SENDER=no-reply@yourdomain.com

# Public frontend URL used by password reset links and CORS
FRONTEND_URL=https://couriernepal.com
# Use shared Redis storage for multi-worker deployments (install redis dependency).
RATELIMIT_STORAGE_URI=rediss://REDIS_USER:REDIS_PASSWORD@REDIS_HOST:REDIS_PORT/0

BACKEND_PROXY_SECRET=generate-a-third-independent-random-secret

# Number of proxy hops to trust when reading the client address from
# X-Forwarded-For. The API sits behind the frontend's same-origin /api proxy,
# so this must be 1 in production. Left at 0, every request appears to come
# from the proxy: rate limits become one bucket shared by the whole internet
# (ten junk sign-ins a minute would lock out every customer) and the audit log
# records the wrong source for every action. Required in production.
TRUSTED_PROXY_HOPS=1

# Encrypts carrier and payment-gateway credentials held in the database.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset, the key is derived from SECRET_KEY, which means rotating the session
# secret would make every stored credential unreadable. Required in production.
FIELD_ENCRYPTION_KEY=generate-a-fernet-key
# To rotate: put the new key first, keep the old one so existing rows still read.
# FIELD_ENCRYPTION_KEYS=new-key,old-key

# Whether /auth/login and /auth/refresh also return tokens in the JSON body.
# The browser uses the HttpOnly cookies and ignores these; leaving them on in
# production means any XSS can call refresh and read the bearer token.
# Turn on only for a deployment whose clients are server-to-server.
AUTH_TOKENS_IN_BODY=false

AUTO_CREATE_SCHEMA=false
